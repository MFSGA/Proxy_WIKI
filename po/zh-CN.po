msgstr "其他命令"

msgid "`BIND`"
msgstr "`BIND`"

msgid "`Mux`, `Rvs` are Xray-specific"
msgstr "`Mux`、`Rvs` 为 Xray 特有"

msgid "Address order"
msgstr "地址顺序"

