msgstr "选中的 SOCKS 认证方法，例如 RFC 1929"

#: src\protocols/http.md
msgid "HTTP challenge/response such as `407` + `Proxy-Authorization`"
msgstr "HTTP challenge/response，例如 `407` + `Proxy-Authorization`"

#: src\protocols/http.md
msgid "`CMD=0x01` (`CONNECT`)"
msgstr "`CMD=0x01`（`CONNECT`）"

#: src\protocols/http.md
msgid "HTTP method `CONNECT`"
msgstr "HTTP 方法 `CONNECT`"

#: src\protocols/http.md
msgid "Destination type"
msgstr "目标类型"

#: src\protocols/http.md
msgid "Explicit `ATYP` for IPv4/domain/IPv6"
msgstr "通过显式 `ATYP` 表示 IPv4/域名/IPv6"

#: src\protocols/http.md
msgid "Textual authority `host:port` at the semantic layer"
msgstr "语义层使用文本 authority `host:port`"

#: src\protocols/http.md
msgid "2-byte network-order integer"
msgstr "2 字节网络字节序整数"

#: src\protocols/http.md
msgid "Decimal text in HTTP/1.1 authority form"
msgstr "HTTP/1.1 authority-form 中的十进制文本"

#: src\protocols/http.md
