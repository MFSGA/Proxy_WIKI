msgstr "TCP 成功回复"

msgid "explicit `REP` response"
msgstr "显式 `REP` 响应"

msgid "version + addons response; no SOCKS-style `REP`"
msgstr "版本 + addons 响应；没有 SOCKS 风格 `REP`"

msgid "Bound address in response"
msgstr "响应中的绑定地址"

msgid "yes"
msgstr "有"

